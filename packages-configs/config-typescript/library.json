{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "moduleResolution": "node",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,

    "jsx": "react-jsx",
    "lib": ["ES2021"],
    "module": "ESNext",
    "target": "ES2021"
  },
  "exclude": ["node_modules"]
}
